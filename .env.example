# Copy to .env for local development. Never commit .env.
POSTGRES_DB=automation
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-admin-change-me
POSTGRES_MIGRATOR_USER=automation_migrator
POSTGRES_MIGRATOR_PASSWORD=local-migrator-change-me
POSTGRES_API_USER=automation_api
POSTGRES_API_PASSWORD=local-api-change-me
POSTGRES_WORKER_USER=automation_worker
POSTGRES_WORKER_PASSWORD=local-worker-change-me
POSTGRES_CONTROL_USER=automation_control
POSTGRES_CONTROL_PASSWORD=local-control-change-me

DATABASE_URL=postgresql+asyncpg://automation_api:local-api-change-me@postgres:5432/automation
MIGRATION_DATABASE_URL=postgresql+asyncpg://automation_migrator:local-migrator-change-me@postgres:5432/automation
WORKER_DATABASE_URL=postgresql+asyncpg://automation_worker:local-worker-change-me@postgres:5432/automation
CONTROL_DATABASE_URL=postgresql+asyncpg://automation_control:local-control-change-me@postgres:5432/automation
REDIS_URL=redis://redis:6379/0

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
